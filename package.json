{
  "name": "cryo-ai-seminar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "15-minute live reveal.js seminar: AI in cryo-EM and cryo-ET data processing (BCH 561)",
  "scripts": {
    "dev": "vite",
    "qa": "node scripts/qa-check.mjs",
    "build": "node scripts/qa-check.mjs && tsc -b && vite build && node scripts/check-dist.mjs",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "node tests/run-tests.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:mp4": "node scripts/export-mp4.mjs",
    "transcript": "node scripts/make-transcript.mjs",
    "videos": "node production/remotion/render-all.mjs",
    "export:pptx": "node scripts/make-cue-sheet.mjs && node scripts/export-pptx.mjs"
  },
  "dependencies": {
    "@revealjs/react": "0.2.2",
    "d3": "7.9.0",
    "katex": "0.16.22",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "reveal.js": "6.0.2"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/d3": "7.4.3",
    "@types/js-yaml": "4.0.9",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "js-yaml": "4.1.0",
    "playwright-core": "1.63.0",
    "pptxgenjs": "^3.12.0",
    "remotion": "4.0.532",
    "typescript": "5.9.3",
    "vite": "8.3.2"
  }
}
